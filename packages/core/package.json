{
  "name": "@citestar/core",
  "version": "0.0.0",
  "private": true,
  "description": "DOM-free pipeline: extract, detect, link, score, track.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/neutral-build.ts src/index.ts dist/index.js && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json"
  }
}
